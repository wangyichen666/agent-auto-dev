<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 安装时替换 __HOME__，不得直接加载此模板。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dtcoder.agentic-dev</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/share/dtcoder/.venv/bin/dtcoder-agentic-dev</string>
    <string>--config</string><string>__HOME__/.dtcoder-agentic-dev/config.yaml</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>ExitTimeOut</key><integer>1900</integer>
  <key>StandardOutPath</key><string>__HOME__/.dtcoder-agentic-dev/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.dtcoder-agentic-dev/logs/launchd.log</string>
</dict>
</plist>
